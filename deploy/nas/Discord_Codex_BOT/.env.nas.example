# Copy to .env.nas on the NAS and fill values there.
# Do not commit .env.nas.

ATTYS_NAS_CONTROL_PLANE_NAME=attys-dc-bot-nas
ATTYS_NAS_PUBLIC_BASE_URL=
ATTYS_NAS_WORKERS_JSON=[{"id":"otthon","label":"Otthoni Windows worker","baseUrl":"http://worker-home.example.invalid:8787","sharedSecretEnv":"ATTYS_WORKER_SHARED_SECRET_HOME","workspaceRootLabel":"codex_works-home"}]
ATTYS_NAS_STATUS_PROJECT=Attys_DC_BOT
ATTYS_NAS_STATUS_CHECK=
ATTYS_WORKER_SHARED_SECRET_HOME=change-me-on-nas
ATTYS_WORKER_HEARTBEAT_TIMEOUT_MS=120000
ATTYS_NAS_STATUS_POLL_INTERVAL_MS=60000
ATTYS_NAS_WORKER_STORE_PATH=./data/workers.json
ATTYS_NAS_HANDOFF_ROOT=./data/handoff
ATTYS_WORKER_ID=local-windows-worker
ATTYS_WORKER_LABEL=Windows Worker
ATTYS_WORKSPACE_ROOT_LABEL=codex_works
ATTYS_WORKER_CAPABILITIES=health,heartbeat,status

# The NAS must not receive Codex auth state or Windows workspace credentials.
ATTYS_NAS_CODEX_EXECUTION_ENABLED=false
