# Copy to .env.nas on the NAS and fill values there.
# Do not commit .env.nas.

ATTYS_NAS_CONTROL_PLANE_NAME=attys-dc-bot-nas
ATTYS_NAS_PUBLIC_BASE_URL=
ATTYS_WORKER_HEARTBEAT_TIMEOUT_MS=120000

# The NAS must not receive Codex auth state or Windows workspace credentials.
ATTYS_NAS_CODEX_EXECUTION_ENABLED=false
