{
  "name": "attys-dc-bot",
  "version": "0.1.1-prerelease.78",
  "description": "Local-first Windows Discord control surface for Codex CLI",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup src/index.ts --format esm --dts",
    "start": "node dist/index.js",
    "doctor:local": "tsx src/cli/preflight.ts",
    "nas:prepare": "pwsh -NoProfile -File scripts/prepare-nas-staging.ps1",
    "nas:check": "pwsh -NoProfile -File scripts/check-nas-staging.ps1",
    "nas:sync-share": "pwsh -NoProfile -File scripts/sync-nas-share.ps1",
    "nas:deploy": "pwsh -NoProfile -File scripts/deploy-nas-control-plane.ps1",
    "nas:deploy:verify": "tsx src/cli/nas-deploy-verify.ts",
    "nas:status": "tsx src/cli/nas-status.ts",
    "nas:control-plane": "tsx src/cli/nas-control-plane.ts",
    "nas:handoff:status": "tsx src/cli/nas-handoff-status.ts",
    "nas:handoff:audit-request": "tsx src/cli/nas-handoff-audit-request.ts",
    "nas:workers:health": "tsx src/cli/nas-workers-health.ts",
    "nas:workers:repo-status": "tsx src/cli/nas-workers-repo-status.ts",
    "nas:workers:check": "tsx src/cli/nas-workers-check.ts",
    "nas:worker:heartbeat": "tsx src/cli/nas-worker-heartbeat.ts",
    "nas:bridge:status": "pwsh -NoProfile -File scripts/nas-bridge-lifecycle.ps1 -Action status",
    "nas:bridge:start": "pwsh -NoProfile -File scripts/nas-bridge-lifecycle.ps1 -Action start",
    "nas:bridge:stop": "pwsh -NoProfile -File scripts/nas-bridge-lifecycle.ps1 -Action stop",
    "nas:bridge:restart": "pwsh -NoProfile -File scripts/nas-bridge-lifecycle.ps1 -Action restart",
    "nas:bridge:smoke": "pwsh -NoProfile -File scripts/nas-bridge-smoke.ps1",
    "nas:container:status": "pwsh -NoProfile -File scripts/nas-container-lifecycle.ps1 -Action status",
    "nas:container:rebuild": "pwsh -NoProfile -File scripts/nas-container-lifecycle.ps1 -Action rebuild",
    "worker:http": "tsx src/cli/worker-http.ts",
    "worker:http:start": "pwsh -NoProfile -File scripts/start-worker-http.ps1",
    "worker:http:status": "pwsh -NoProfile -File scripts/worker-http-lifecycle.ps1 -Action status",
    "worker:http:stop": "pwsh -NoProfile -File scripts/worker-http-lifecycle.ps1 -Action stop",
    "worker:http:restart": "pwsh -NoProfile -File scripts/worker-http-lifecycle.ps1 -Action restart",
    "worker:handoff:once": "tsx src/cli/worker-handoff-once.ts",
    "worker:handoff:loop": "tsx src/cli/worker-handoff-loop.ts",
    "worker:handoff:status": "pwsh -NoProfile -File scripts/worker-handoff-lifecycle.ps1 -Action status",
    "worker:handoff:stop": "pwsh -NoProfile -File scripts/worker-handoff-lifecycle.ps1 -Action stop",
    "worker:handoff:restart": "pwsh -NoProfile -File scripts/worker-handoff-lifecycle.ps1 -Action restart",
    "worker:smoke": "pwsh -NoProfile -File scripts/worker-http-smoke.ps1",
    "botops:nas:status": "tsx src/cli/botops-nas-worker.ts --status",
    "botops:nas:once": "tsx src/cli/botops-nas-worker.ts --once",
    "botops:nas:loop": "tsx src/cli/botops-nas-worker.ts --loop",
    "botops:windows:status": "tsx src/cli/botops-windows-worker.ts --status",
    "botops:windows:once": "tsx src/cli/botops-windows-worker.ts --once",
    "botops:windows:loop": "tsx src/cli/botops-windows-worker.ts --loop",
    "botops:worker:nas:status": "tsx src/cli/botops-worker-supervisor.ts nas status",
    "botops:worker:nas:start": "tsx src/cli/botops-worker-supervisor.ts nas start",
    "botops:worker:nas:stop": "tsx src/cli/botops-worker-supervisor.ts nas stop",
    "botops:worker:nas:restart": "tsx src/cli/botops-worker-supervisor.ts nas restart",
    "botops:worker:windows:status": "tsx src/cli/botops-worker-supervisor.ts windows status",
    "botops:worker:windows:start": "tsx src/cli/botops-worker-supervisor.ts windows start",
    "botops:worker:windows:stop": "tsx src/cli/botops-worker-supervisor.ts windows stop",
    "botops:worker:windows:restart": "tsx src/cli/botops-worker-supervisor.ts windows restart",
    "audit:check": "tsx src/cli/audit-check.ts",
    "audit:repair-flow:smoke": "tsx src/cli/audit-repair-flow-smoke.ts",
    "plans:check": "tsx src/cli/plans-check.ts",
    "safe-update:status": "tsx src/cli/safe-update.ts --status",
    "safe-update:apply": "tsx src/cli/safe-update.ts --apply",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run plans:check && npm run lint && npm run typecheck && npm test && npm run audit:repair-flow:smoke && npm run build",
    "secret:scan": "ggshield secret scan path --recursive --yes --use-gitignore ."
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "discord.js": "^14.27.0",
    "dotenv": "^17.2.4",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.2",
    "eslint": "^10.5.0",
    "globals": "^17.7.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}
